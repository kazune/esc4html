#!/bin/sh

# Keep this command stdin-only; never pass arguments through to sed.
if [ "$#" -ne 0 ]; then
	printf 'Usage: %s\n' "${0##*/}" >&2
	exit 2
fi

# Always escape the five special characters; existing references are escaped again.
exec sed \
	-e 's/&/\&amp;/g' \
	-e 's/</\&lt;/g' \
	-e 's/>/\&gt;/g' \
	-e 's/"/\&quot;/g' \
	-e "s/'/\&#39;/g"
